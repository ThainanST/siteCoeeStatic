---
interface Props {
  people: { name: string; role: string; photo?: string }[];
}
const { people } = Astro.props;
---
<div class="people-grid">
  {people.map((person) => (
    <article class="person-card">
      <div class="person-portrait">
        {person.photo
          ? <img src={person.photo} alt={`Foto de ${person.name}`} loading="lazy" />
          : <svg viewBox="0 0 96 96" aria-hidden="true"><circle cx="48" cy="33" r="16" /><path d="M17 86c1-20 13-31 31-31s30 11 31 31" /></svg>}
      </div>
      <div class="person-info"><span class="person-label">COEE · DEMONSTRAÇÃO</span><h2>{person.name.replace(" (demonstração)", "")}</h2><p>{person.role}</p></div>
    </article>
  ))}
</div>
