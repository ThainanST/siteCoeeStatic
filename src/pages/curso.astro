---
import SectionLayout from "../layouts/SectionLayout.astro";
import data from "../data/site.js";
import { officialLinks } from "../data/navigation.js";
---
<SectionLayout title="Sobre o curso" group="curso" section="sobre" description={data.course.intro}>
  <section class="content-section">
    <h2>Conheça o DEELT</h2>
    <p>Consulte as páginas oficiais do Departamento de Engenharia Elétrica para conhecer as pessoas, os espaços e as atividades do curso.</p>
    <ul class="official-links">
      <li><a href={officialLinks.docentes}>Docentes ↗</a></li>
      <li><a href={officialLinks.laboratorios}>Laboratórios ↗</a></li>
      <li><a href={officialLinks.pesquisa}>Pesquisa ↗</a></li>
      <li><a href={officialLinks.extensao}>Extensão ↗</a></li>
    </ul>
  </section>
</SectionLayout>
