---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading.astro";
import data from "../data/site.js";
import { base } from "../utils/base.js";
---
<Layout title="Curso" page="curso" description="Conheça o curso de Engenharia Elétrica da UFOP no ICEA.">
  <PageHeading eyebrow="Graduação · ICEA · UFOP" title="Curso de Engenharia Elétrica" description={data.course.intro} />
  <div class="card-grid course-grid">
    {data.course.topics.map((topic) => <article class="info-card"><span class="card-index">COEE</span><h2>{topic.title}</h2><p>{topic.text}</p></article>)}
  </div>
  <div class="callout"><strong>Precisa consultar horários?</strong><a class="text-link" href={`${base}area-do-aluno.html#horarios`}>Ir para horários e serviços do aluno →</a></div>
</Layout>
