---
import SectionLayout from "../layouts/SectionLayout.astro";
import DocumentList from "../components/DocumentList.astro";
import data from "../data/site.js";
import { officialLinks } from "../data/navigation.js";
---
<SectionLayout title="Links e orientações" group="aluno" description="Acesse serviços e outras informações úteis para estudantes.">
  <section class="content-section useful-links">
    <h2>Links úteis</h2>
    <p>Acesse os serviços oficiais da UFOP.</p>
    <ul class="official-links">
      <li id="calendario"><a href={officialLinks.calendario}>Calendário acadêmico ↗</a></li>
      <li id="apoio"><a href={officialLinks.psicologia}>Atendimento psicológico em João Monlevade ↗</a></li>
    </ul>
  </section>
  <section class="content-section useful-links">
    <h2>Outras orientações</h2>
    {data.studentTasks.filter((task) => ["horarios", "bolsas"].includes(task.id)).map((task) => <details class="declaration-info" id={task.id}>
      <summary>{task.title}</summary>
      <p>{task.description}</p>
      <p><strong>Requisitos:</strong> {task.requirements.join(" ")}</p>
      <p><strong>Formulário:</strong> {task.form}</p>
      <DocumentList documents={task.document ? [task.document] : []} />
      <p><strong>Canal:</strong> {task.channel}</p>
      <p><strong>Norma:</strong> {task.norm}</p>
    </details>)}
  </section>
</SectionLayout>
<script>
  import { base } from "../utils/base.js";
  const previousLinks: Record<string, string> = {
    "#estagio": "aluno-estagio.html",
    "#aproveitamento": "aluno-aproveitamento.html",
    "#enfase": "aluno-enfase.html",
    "#atividades": "aluno-atividades.html"
  };
  const destination = previousLinks[window.location.hash];
  if (destination) window.location.replace(`${base}${destination}`);
</script>
