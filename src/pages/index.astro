---
import Layout from "../layouts/Layout.astro";
import PublicationCard from "../components/PublicationCard.astro";
import data from "../data/site.js";
import { base } from "../utils/base.js";

const shortcuts = [
  { title: "Horários", href: "area-do-aluno.html#horarios" },
  { title: "TCC", href: "tcc.html" },
  { title: "Estágio curricular", href: "area-do-aluno.html#estagio" },
  { title: "Calendário acadêmico", href: "area-do-aluno.html#calendario" }
];
const services = [
  { title: "Sobre o Colegiado", href: "colegiado.html" },
  { title: "Concessão de ênfase", href: "area-do-aluno.html#enfase" },
  { title: "Aproveitamento de estudos", href: "area-do-aluno.html#aproveitamento" },
  { title: "Atividades acadêmicas", href: "area-do-aluno.html#atividades" },
  { title: "Resoluções", href: "colegiado-documentos.html" },
  { title: "Apoio ao estudante", href: "area-do-aluno.html#apoio" }
];
const notice = data.notices[0];
---
<Layout title="Início" page="inicio" description="Informações, serviços e orientações do Colegiado do Curso de Engenharia Elétrica da UFOP.">
  <div class="home-layout">
    <aside class="home-sidebar" aria-labelledby="shortcut-heading">
      <div class="sidebar-heading"><span class="sidebar-kicker">Para estudantes</span><h2 id="shortcut-heading">Acesso rápido</h2></div>
      <nav class="shortcut-grid" aria-label="Atalhos principais">
        {shortcuts.map((item) => <a class="shortcut-card" href={`${base}${item.href}`}><span>{item.title}</span><span aria-hidden="true">→</span></a>)}
      </nav>
      <details class="more-links">
        <summary>Mais serviços</summary>
        <nav aria-label="Outros serviços">{services.map((item) => <a href={`${base}${item.href}`}>{item.title}</a>)}</nav>
      </details>
      <div class="sidebar-contact"><p>Precisa de ajuda?</p><a href={`${base}colegiado-contato.html`}>Fale com o Colegiado →</a></div>
    </aside>
    <div class="home-main">
      <p class="home-location">Engenharia Elétrica <span> / </span> ICEA · UFOP · João Monlevade</p>
      <section class="home-hero">
        <div class="hero-copy">
          <p class="hero-kicker">Colegiado de Engenharia Elétrica</p>
          <h1>Informação para acompanhar sua trajetória.</h1>
          <p>Orientações, documentos e oportunidades do curso em um só lugar.</p>
          <a class="hero-link" href={`${base}area-do-aluno.html`}>Acessar área do aluno <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-art" aria-hidden="true"></div>
      </section>
      <section class="notice-banner" aria-labelledby="notice-title">
        <div><p class="eyebrow">Aviso em destaque · {notice.date}</p><h2 id="notice-title">{notice.title}</h2><p>{notice.text}</p></div>
        <a class="text-link" href={`${base}${notice.href}`}>Ver orientações <span aria-hidden="true">→</span></a>
      </section>
      <section class="recent-section">
        <div class="section-heading"><div><p class="eyebrow">Acompanhe o curso</p><h2>Notícias e editais</h2></div><a class="text-link" href={`${base}noticias-e-editais.html`}>Ver todas <span aria-hidden="true">→</span></a></div>
        <div class="publication-grid">{data.publications.map((item) => <PublicationCard item={item} />)}</div>
      </section>
    </div>
  </div>
</Layout>
